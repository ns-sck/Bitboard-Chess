{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: g++ build all files",
      "command": "g++",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c++17",
        "-Wall",
        "-I.",
        "-I./include/pieces",
        "*.cpp",
        "src/pieces/*.cpp",
        "-o",
        "${workspaceFolder}/game.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated for building all files."
    }
  ],
  "version": "2.0.0"
}